---
import { Font } from 'astro:assets';
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';
import LivingBackground from '../components/LivingBackground.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  /** Absolute URL of this page's markdown twin (§11). Passed explicitly —
      deriving it from `canonical` yields /about/index.md, which is a 404. */
  markdownUrl?: string;
  jsonLd?: object;
}
const { title, description, canonical, markdownUrl, jsonLd } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- FIRST in <head>, before anything that can paint. Astro inlines small
         stylesheets as <style>, and <Font> emits @font-face <style> blocks, so
         "before the stylesheet link" is not a strong enough position — being
         first is. Blocking and inline by design: it must run before first paint
         or every dark-theme visitor sees a white flash on every navigation. -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('theme');
          var t = (s === 'light' || s === 'dark')
            ? s
            : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', t);

          var m = localStorage.getItem('motion');
          var mo = (m === 'full' || m === 'reduced')
            ? m
            : (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full');
          document.documentElement.setAttribute('data-motion', mo);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('data-motion', 'full');
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- The wordmark's own `a.` — rasterised from real JetBrains Mono, not an
         SVG <text>: a favicon renders without the page's webfonts, so an SVG
         mark would fall back to whatever mono the visitor's OS happens to have
         and stop being this letterform. Sizes are declared so the browser picks
         rather than downscaling one bitmap. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Agent-facing alternates (§11) -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" preload />

    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <LivingBackground />
    <div class="relative z-[1]">
      <slot />
    </div>
  </body>
</html>
