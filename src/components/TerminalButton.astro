---
interface Props { variant?: 'nav' | 'hero' }
const { variant = 'hero' } = Astro.props;
---
{variant === 'hero' ? (
  <button
    type="button"
    data-open-terminal
    class="inline-flex items-center gap-3 rounded-[10px] border border-[var(--color-neutral-800)] bg-[var(--color-panel)] px-4 py-3 font-mono text-[13px] text-[var(--color-neutral-300)] hover:border-[var(--color-accent)]"
  >
    <span class="text-[var(--color-accent)]">❯</span>
    <span>poke around in the terminal</span>
    <kbd class="rounded border border-[var(--color-neutral-800)] px-1.5 py-[3px] font-mono text-[11px] text-[var(--color-neutral-600)]">` or ⌘K</kbd>
  </button>
) : (
  <button
    type="button"
    data-open-terminal
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-neutral-800)] py-1.5 pl-3 pr-2.5 text-[13px] text-[var(--color-neutral-400)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent-300)]"
  >
    Terminal
    <kbd class="hidden md:inline-flex rounded border border-[var(--color-neutral-800)] px-1.5 py-[3px] font-mono text-[11px] text-[var(--color-neutral-600)]">`</kbd>
  </button>
)}

<script>
  // Every trigger dispatches the same event; the island listens once.
  document.querySelectorAll('[data-open-terminal]').forEach((b) =>
    b.addEventListener('click', () =>
      window.dispatchEvent(new KeyboardEvent('keydown', { key: '`' })),
    ),
  );
</script>
